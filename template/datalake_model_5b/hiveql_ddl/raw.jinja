-- Purpose:    RAW-DDL-CREATE TABLE
-- Author:     {{ author | default('Datalake') }}
-- CreateDate: {{ created_date }}
-- FileType:   DDL

-- 1.0 drop table if exists table
DROP TABLE IF EXISTS ${raw_schema}.{{ target.table_name.upper() }};

-- 1.1 create table
CREATE TABLE ${raw_schema}.{{ target.table_name.upper() }}(
    {% for col in columns if not col.is_partition %}
    {{ ", " if not loop.first else "" }}{{ col.name.upper() }} {{ TypeResolver.get_datatype(col.data_type.upper(), dialect='hive') }} COMMENT ''
    {% endfor %}
    , RAW_SYS_TIME STRING COMMENT 'Source processing time'
    , ETL_TIMESTAMP STRING COMMENT 'ETL_PROCESSING_TIME'
    , HASH_VALUE STRING COMMENT 'Keep track changes'
)
COMMENT '{{ options.comment | default('') }}'
PARTITIONED BY (
    {%- for p_key in target.partition_keys %}
    {{ ", " if not loop.first else "" }}{{ p_key.upper() }} STRING COMMENT 'Partition Date'
    {%- endfor %}
)
STORED AS PARQUET
TBLPROPERTIES(
    'PARQUET.COMPRESSION'='SNAPPY'
    ,'EXTERNAL.TABLE.PURGE'='TRUE'
)
;