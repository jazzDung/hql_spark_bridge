import os
import sys
sys.path.append(os.environ["sys_path_py_script"])
from etl_common_function import run_etl, set_parameter
from pyspark.sql.functions import current_timestamp

source_name = "{{ source_name }}"
table_name  = "{{ base_table }}"

spark, ext_start_time, ext_end_time, today_date, yesterday_date = run_etl(source_name, table_name)
batch_date = today_date
params = set_parameter(spark)

{% if source_processing_sqls %}
# ─── PRE-PROCESSING (Temp tables logic from legacy script) ───────────────────
{% for step_sql in source_processing_sqls %}
spark.sql(f"""
{{ step_sql | comment_formatting | indent(4) }}
""")
{% endfor %}
{% endif %}

# ─── DELTA TABLE SETUP (EXTRACT IMPACTED primary_key FROM COM_T) ───────────────────
# Find all distinct key columns where records were updated in the current batch
# Then pull ALL active records from COM_T for those primary_key.
spark.sql(f"""DROP TABLE IF EXISTS {params["com_schema"]}.temp_{{ target_table_name }}_delta""")
spark.sql(f"""
    CREATE TABLE {params["com_schema"]}.temp_{{ target_table_name }}_delta (
        {% for col in original_columns %}
        {{ ", " if not loop.first else "" }}{{ col.name }} {{ col.type }}
        {% endfor %}
    )
    stored as parquet
    tblproperties('parquet.compression'='SNAPPY', 'external.table.purge'='true')
""")

spark.sql(f"""
    INSERT INTO TABLE {params["com_schema"]}.temp_{{ target_table_name }}_delta
    SELECT
        {% for col in original_columns %}
        com_t.{{ col.name }}{{ "," if not loop.last else "" }}
        {% endfor %}
    FROM {params["com_schema"]}.{{ target_table_name }} com_t
    INNER JOIN (
        SELECT DISTINCT {% for k in primary_key %}{{ k }}{{ "," if not loop.last else "" }}{% endfor %}
        FROM {params["com_schema"]}.{{ target_table_name }}
        WHERE DATE_FORMAT(dl_record_updated_date, 'yyyyMMdd') = '{batch_date}'
    ) delta_key
    ON {% for k in primary_key %}com_t.{{ k }} = delta_key.{{ k }}{% if not loop.last %} AND {% endif %}{% endfor %}
    WHERE com_t.dl_record_status = 'A'
""")

# ─── UPDATED TABLE SETUP ─────────────────────────────────────────────────────
spark.sql(f"""DROP TABLE IF EXISTS {params["com_schema"]}.temp_{{ target_table_name }}_updated""")
spark.sql(f"""
    CREATE TABLE {params["com_schema"]}.temp_{{ target_table_name }}_updated (
        {% for col in original_columns %}
        {{ ", " if not loop.first else "" }}{{ col.name }} {{ col.type }}
        {% endfor %}
        , dl_record_created_date TIMESTAMP
        , dl_record_updated_date TIMESTAMP
    )
    stored as parquet
    tblproperties('parquet.compression'='SNAPPY', 'external.table.purge'='true')
""")

# ─── STEP 1: Keep existing records from CUR that are NOT in impacted primary_key ──
spark.sql(f"""
    INSERT INTO TABLE {params["com_schema"]}.temp_{{ target_table_name }}_updated
    SELECT
        {% for col in original_columns %}
        cur.{{ col.name }},
        {% endfor %}
        cur.dl_record_created_date,
        cur.dl_record_updated_date
    FROM {params["cur_schema"]}.{{ target_table_name }} cur
    WHERE
        {% if partition_key %}cur.{{ partition_key }} = '{{ source_key_value }}' AND {% endif %}
        NOT EXISTS (
            SELECT 1 FROM {params["com_schema"]}.temp_{{ target_table_name }}_delta delta
            WHERE {% for k in primary_key %}delta.{{ k }} = cur.{{ k }}{% if not loop.last %} AND {% endif %}{% endfor %}
        )
""")

# ─── STEP 2: Insert transformed delta into temp table ────────────────────────
# main_processing_sqls is expected to transform data from temp_{target_table_name}_delta
# ─── INSERT INTO CONSOLIDATED TABLE ────────────────────────────────────────────────────────

{% if main_processing_sqls %}
{% for main_sql in main_processing_sqls %}
spark.sql(f"""
{{ main_sql  | comment_formatting  | indent(4) }}
""")

{% endfor %}
{% endif %}

# ─── STEP 3: Overwrite CUR table ─────────────────────────────────────────────
spark.sql(f"""
    INSERT OVERWRITE TABLE {params["cur_schema"]}.{{ target_table_name }} {% if partition_key %}PARTITION ({{ partition_key }} = '{{ source_key_value }}'){% endif %}
    SELECT
        {% for col in original_columns %}
        {{ col.name }},
        {% endfor %}
        dl_record_created_date,
        dl_record_updated_date,
        '{batch_date}' AS etl_dt,
        current_timestamp() AS etl_timestamp
    FROM {params["com_schema"]}.temp_{{ target_table_name }}_updated
""")

spark.sql(f"""
    ANALYZE TABLE {params["cur_schema"]}.{{ target_table_name }} {% if partition_key %}PARTITION ({{ partition_key }} = '{{ source_key_value }}'){% endif %} COMPUTE STATISTICS
""")

spark.stop()
