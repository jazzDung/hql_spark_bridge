import os
import sys
sys.path.append(os.environ["sys_path_py_script"])
from etl_common_function import run_etl_cur, set_parameter
from pyspark.sql.functions import current_timestamp

# spark session
source_name = "{{ source_name }}"
table_name  = "{{ base_table }}"

# set parameter, call parameter by params["<parameter name>"]
spark, batch_date = run_etl_cur(source_name, table_name)
params = set_parameter(spark)

# Enable dynamic partition overwrites if there is a partition key
{% if partition_key %}
spark.sql("SET spark.sql.sources.partitionOverwriteMode=dynamic")
{% endif %}

{% if source_processing_sqls %}
# ─── SOURCE PROCESSING (Temp tables logic from legacy script) ───────────────────
{% for step_sql in source_processing_sqls %}
spark.sql(f"""
{{ step_sql | comment_formatting | indent(4) }}
""")
{% endfor %}
{% endif %}

# ─── DELTA TABLE SETUP (TRANSFORMED COM_T) ──────────────────────────────────
# This table will hold the transformed delta records from the COM layer.
spark.sql(f"""DROP TABLE IF EXISTS {params["tmp_schema"]}.temp_{{ target_table_name }}_delta""")
spark.sql(f"""
    CREATE TABLE {params["tmp_schema"]}.temp_{{ target_table_name }}_delta (
        {% for col in original_columns %}
        {{ ", " if not loop.first else "" }}{{ col.name }} {{ col.type }}
        {% endfor %}
        , dl_record_status       VARCHAR(10)
        , dl_record_created_date TIMESTAMP
        , dl_record_updated_date TIMESTAMP
    )
    stored as parquet
    tblproperties('parquet.compression'='SNAPPY', 'external.table.purge'='true')
""")

# ─── MAIN PROCESSING (Populate Delta Table) ───────────────────────────────────
# The main_processing_sqls should contain the logic to transform and insert data
# from com_t into the temp delta table, filtering for the current batch_date.
{% if main_processing_sqls %}
{% for main_sql in main_processing_sqls %}
spark.sql(f"""
{{ main_sql | comment_formatting | indent(4) }}
""")
{% endfor %}
{% endif %}

# ─── UPDATED TABLE SETUP ─────────────────────────────────────────────────────
# This table will hold the final, merged dataset.
spark.sql(f"""DROP TABLE IF EXISTS {params["tmp_schema"]}.temp_{{ target_table_name }}_updated""")
spark.sql(f"""
    CREATE TABLE {params["tmp_schema"]}.temp_{{ target_table_name }}_updated (
        {% for col in original_columns %}
        {{ ", " if not loop.first else "" }}{{ col.name }} {{ col.type }}
        {% endfor %}
        , dl_record_status       VARCHAR(10)
        , dl_record_created_date TIMESTAMP
        , dl_record_updated_date TIMESTAMP
        , source_name            VARCHAR(10)
    )
    stored as parquet
    tblproperties('parquet.compression'='SNAPPY', 'external.table.purge'='true')
""")

# ─── STEP 1: Keep unchanged records from CUR ──────────────────────────────────
spark.sql(f"""
    INSERT INTO TABLE {params["tmp_schema"]}.temp_{{ target_table_name }}_updated
    SELECT
        {% for col in original_columns %}
        {{ ", " if not loop.first else "" }}cur.{{ col.name }}
        {% endfor %}
        , cur.dl_record_status
        , cur.dl_record_created_date
        , cur.dl_record_updated_date
        , cur.source_name
    FROM {params["cur_schema"]}.{{ target_table_name }} cur
    WHERE {% if partition_key %}cur.{{ partition_key }} = '{{ source_key_value }}'
    AND {% endif %}NOT EXISTS (
            SELECT 1 FROM {params["tmp_schema"]}.temp_{{ target_table_name }}_delta delta
            WHERE {% for k in primary_key %}{% if not loop.first %}
                AND {% endif %}delta.{{ k }} = cur.{{ k }}{% endfor %}
        )
""")

# ─── STEP 2: Upsert transformed delta into temp table ────────────────────────
spark.sql(f"""
    INSERT INTO TABLE {params["tmp_schema"]}.temp_{{ target_table_name }}_updated
    SELECT
        {% for col in original_columns %}
        {{ ", " if not loop.first else "" }}delta.{{ col.name }}
        {% endfor %}
        , delta.dl_record_status
        , CASE
            WHEN cur.{{ primary_key[0] }} IS NOT NULL THEN cur.dl_record_created_date
            ELSE delta.dl_record_created_date
            END AS dl_record_created_date
        , delta.dl_record_updated_date
        , <<source_name>> AS source_name
    FROM {params["tmp_schema"]}.temp_{{ target_table_name }}_delta delta
    LEFT JOIN {params["cur_schema"]}.{{ target_table_name }} cur
        ON {% if partition_key %}cur.{{ partition_key }} = '{{ source_key_value }}'
        AND{% endif %}{% for k in primary_key %} delta.{{ k }} = cur.{{ k }}
        {% endfor %}
""")

# ─── STEP 3: Insert previous state of changed records into History table ─────
spark.sql(f"""
    INSERT INTO TABLE {params["cur_schema"]}.{{ target_table_name }}_h PARTITION ({% if partition_key %}{{ partition_key }}, {% endif %}hist_year)
    SELECT
        {% for col in original_columns %}
        {{ ", " if not loop.first else "" }}cur.{{ col.name }}
        {% endfor %}
        , cur.dl_record_status
        , cur.dl_record_created_date
        , cur.dl_record_updated_date
        , cur.source_name
        , '{batch_date}' AS etl_dt
        , current_timestamp() AS etl_timestamp
        , MD5(
            CONCAT_WS('||' {% for col in original_columns %}
                {% if partition_key and col.name != partition_key %}, UPPER(TRIM(COALESCE(CAST(cur.{{ col.name }} AS STRING), '∅'))) {% endif %}
            {% endfor %}
        )) AS hash_value
        {% if partition_key %}, cur.{{ partition_key }} AS {{ partition_key }}{% endif %}
        , DATE_FORMAT(current_timestamp(), 'yyyy') AS hist_year
    FROM {params["cur_schema"]}.{{ target_table_name }} cur
    WHERE {% if partition_key %}cur.{{ partition_key }} = '{{ source_key_value }}'
        AND {% endif %} EXISTS (
            SELECT 1 FROM {params["tmp_schema"]}.temp_{{ target_table_name }}_delta delta
            WHERE {% for k in primary_key %}{% if not loop.first %}
                AND {% endif %}delta.{{ k }} = cur.{{ k }}{% endfor %}
        )
""")

# ─── STEP 4: Overwrite CUR table ──────────────────────────────────────────────
spark.sql(f"""
    INSERT OVERWRITE TABLE {params["cur_schema"]}.{{ target_table_name }}{% if partition_key %} PARTITION ({{ partition_key }} = '{{ source_key_value }}'){% endif %}
    SELECT
        {% for col in original_columns %}
        {{ ", " if not loop.first else "" }}{{ col.name }}
        {% endfor %}
        , dl_record_status
        , dl_record_created_date
        , dl_record_updated_date
        , source_name
        , '{batch_date}' AS etl_dt
        , current_timestamp() AS etl_timestamp
    FROM {params["tmp_schema"]}.temp_{{ target_table_name }}_updated
""")

spark.sql(f"""
    ANALYZE TABLE {params["cur_schema"]}.{{ target_table_name }}{% if partition_key %} PARTITION ({{ partition_key }} = '{{ source_key_value }}'){% endif %} COMPUTE STATISTICS
""")

spark.stop()