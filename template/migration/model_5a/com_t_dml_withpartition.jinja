import os
import sys
sys.path.append("/mapr/Edfdev.kenanga.local/EDF/py_script")
from etl_common_function import run_etl, set_parameter
from pyspark.sql.functions import current_timestamp

source_name = "{{ source_name }}"
table_name  = "{{ base_table }}"

spark, ext_start_time, ext_end_time, today_date, yesterday_date = run_etl(source_name, table_name)
batch_date = today_date
params = set_parameter(spark)

# Enable dynamic partition overwrites
spark.sql("SET spark.sql.sources.partitionOverwriteMode=dynamic")

{% if pre_processing_sqls %}
# ─── PRE-PROCESSING (Temp tables logic from legacy script) ───────────────────
{% for step_sql in pre_processing_sqls %}
spark.sql(f"""
{{ step_sql | comment_formatting | indent(4) }}
""")
{% endfor %}
{% endif %}

# ─── CONSOLIDATED TABLE SETUP (NEW INCREMENTAL DATA) ─────────────────────────
spark.sql(f"""DROP TABLE IF EXISTS {params["com_schema"]}.temp_{{ target_table_name }}_consolidated""")
spark.sql(f"""
    CREATE TABLE {params["com_schema"]}.temp_{{ target_table_name }}_consolidated (
        {% for col in original_columns %}
        {{ ", " if not loop.first else "" }}{{ col.name }} {{ col.type }}
        {% endfor %}
        {% for p_col in partition_columns %}
        , {{ p_col }} STRING
        {% endfor %}
    )
    stored as parquet
    tblproperties('parquet.compression'='SNAPPY', 'external.table.purge'='true')
""")

# ─── INSERT INTO CONSOLIDATED TABLE ────────────────────────────────────────────────────────

{% if main_processing_sqls %}
{% for main_sql in main_processing_sqls %}
spark.sql(f"""
{{ main_sql  | comment_formatting  | indent(4) }}
""")

{% endfor %}
{% endif %}

# ─── TEMP TABLE SETUP ────────────────────────────────────────────────────────
spark.sql(f"""DROP TABLE IF EXISTS {params["com_schema"]}.temp_{{ target_table_name }}_updated""")
spark.sql(f"""
    CREATE TABLE {params["com_schema"]}.temp_{{ target_table_name }}_updated (
        {% for col in original_columns %}
        {{ ", " if not loop.first else "" }}{{ col.name }} {{ col.type }}
        {% endfor %}
        , raw_incremental_etl_dt STRING
        , dl_record_status       VARCHAR(10)
        , dl_record_created_date TIMESTAMP
        , dl_record_updated_date TIMESTAMP
        {% for p_col in partition_columns %}
        , {{ p_col }} STRING
        {% endfor %}
    )
    stored as parquet
    tblproperties('parquet.compression'='SNAPPY', 'external.table.purge'='true')
""")

# ─── STEP 1: Keep existing records from IMPACTED PARTITIONS ONLY ────────────
# Only keep records where raw_incremental_etl_dt != batch_date to avoid duplicates
spark.sql(f"""
    INSERT INTO TABLE {params["com_schema"]}.temp_{{ target_table_name }}_updated
    SELECT
        {% for col in original_columns %}
        com_t.{{ col.name }},
        {% endfor %}
        com_t.raw_incremental_etl_dt,
        com_t.dl_record_status,
        com_t.dl_record_created_date,
        com_t.dl_record_updated_date
        {% for p_col in partition_columns %}
        , com_t.{{ p_col }}
        {% endfor %}
    FROM {params["com_schema"]}.{{ target_table_name }} com_t
    INNER JOIN (
        SELECT DISTINCT {% for p_col in partition_columns %}{{ ", " if not loop.first else "" }}{{ p_col }}{% endfor %}
        FROM {params["com_schema"]}.temp_{{ target_table_name }}_consolidated
    ) impacted_partitions
    ON {% for p_col in partition_columns %}{% if not loop.first %} AND {% endif %}com_t.{{ p_col }} = impacted_partitions.{{ p_col }}{% endfor %}
    WHERE com_t.raw_incremental_etl_dt != '{batch_date}'
""")

# ─── STEP 2: Insert new incremental records from the current batch ───────────
spark.sql(f"""
    INSERT INTO TABLE {params["com_schema"]}.temp_{{ target_table_name }}_updated
    SELECT
        {% for col in original_columns %}
        r.{{ col.name }},
        {% endfor %}
        '{batch_date}' AS raw_incremental_etl_dt,
        'A' AS dl_record_status,
        current_timestamp() AS dl_record_created_date,
        current_timestamp() AS dl_record_updated_date
        {% for p_col in partition_columns %}
        , r.{{ p_col }}
        {% endfor %}
    FROM {params["com_schema"]}.temp_{{ target_table_name }}_consolidated r
""")

# ─── STEP 3: Overwrite target table partitions dynamically ──────────────────
spark.sql(f"""
    INSERT OVERWRITE TABLE {params["com_schema"]}.{{ target_table_name }} PARTITION ({% for p_col in partition_columns %}{{ ", " if not loop.first else "" }}{{ p_col }}{% endfor %})
    SELECT
        {% for col in original_columns %}
        {{ col.name }},
        {% endfor %}
        raw_incremental_etl_dt,
        dl_record_status,
        dl_record_created_date,
        dl_record_updated_date,
        '{batch_date}' AS etl_dt,
        current_timestamp() AS etl_timestamp
        {% for p_col in partition_columns %}
        , {{ p_col }}
        {% endfor %}
    FROM {params["com_schema"]}.temp_{{ target_table_name }}_updated
""")

spark.sql(f"""
    ANALYZE TABLE {params["com_schema"]}.{{ target_table_name }} COMPUTE STATISTICS
""")

spark.stop()
