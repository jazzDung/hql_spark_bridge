import json
import os
import sys
from datetime import datetime, timedelta
from airflow import DAG
from airflow.operators.bash import BashOperator
from airflow.operators.empty import EmptyOperator
from airflow.operators.python import PythonOperator, ShortCircuitOperator
from airflow.datasets import Dataset
from airflow.models import Variable

sys.path.append(Variable.get("sys_path_dags"))
from dag_common_function import load_dag_config_ds, get_env

source_name = "cur"
table_name  = "{{ source_name }}_{{ table_name }}"
DAG_ID = source_name + "_" + table_name

schedule, catchup, default_args = load_dag_config_ds(DAG_ID, __file__)

dataset_flow = None
if schedule:
    dataset_flow = [Dataset(name) for name in schedule]

env = get_env("etl_control")

dag = DAG(
    dag_id=DAG_ID,
    default_args=default_args,
    schedule=dataset_flow,
    catchup=catchup,
    max_active_tasks=1,
)


cur_{{ source_name }}_{{ table_name }} = BashOperator(
    task_id='cur_{{ source_name }}_{{ table_name }}',
    bash_command="""
        set -euo pipefail{% raw %}
        {{ var.value.spark_submit_config_low }} \
        {{ var.value.script_home_cur }}{% endraw %}/cur_{{ source_name }}_{{ table_name }}.py
        """,
    dag=dag,
)

dataset_flow = Dataset(dag.dag_id)

finish = EmptyOperator(
    task_id="finish",
    outlets=[dataset_flow]
)

cur_{{ source_name }}_{{ table_name }} >> finish