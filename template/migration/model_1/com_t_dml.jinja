import os
import sys
sys.path.append("/mapr/Edfdev.kenanga.local/EDF/py_script")
from etl_common_function import run_etl, set_parameter
from pyspark.sql.functions import current_timestamp

source_name = "{{ source_name }}"
table_name  = "{{ base_table }}"

spark, ext_start_time, ext_end_time, today_date, yesterday_date = run_etl(source_name, table_name)
batch_date = today_date
params = set_parameter(spark)

{% if pre_processing_sqls %}
# ─── PRE-PROCESSING (Temp tables logic from legacy script) ───────────────────
{% for step_sql in pre_processing_sqls %}
spark.sql(f"""
{{ step_sql | indent(4) }}
""")
{% endfor %}
{% endif %}

# ─── CONSOLIDATED TABLE (FROM RAW) ───────────────────────────────────────────
# This table holds the transformed, complete dataset from the RAW source for this batch
spark.sql(f"""DROP TABLE IF EXISTS {params["com_schema"]}.temp_{{ target_table_name }}_consolidated""")
spark.sql(f"""
    CREATE TABLE {params["com_schema"]}.temp_{{ target_table_name }}_consolidated (
        {% for col in original_columns %}
        {{ ", " if not loop.first else "" }}{{ col.name }} {{ col.type }}
        {% endfor %}
    )
    stored as parquet
    tblproperties('parquet.compression'='SNAPPY', 'external.table.purge'='true')
""")

spark.sql(f"""
{{ main_processing_sqls | indent(4) }}
""")

# ─── TEMP FINAL TABLE SETUP ──────────────────────────────────────────────────
# This table will be used to build the final state before overwriting the target
spark.sql(f"""DROP TABLE IF EXISTS {params["com_schema"]}.temp_{{ target_table_name }}_final""")
spark.sql(f"""
    CREATE TABLE {params["com_schema"]}.temp_{{ target_table_name }}_final (
        {% for col in original_columns %}
        {{ ", " if not loop.first else "" }}{{ col.name }} {{ col.type }}
        {% endfor %}
        , dl_record_status       VARCHAR(10)
        , dl_record_created_date TIMESTAMP
        , dl_record_updated_date TIMESTAMP
    )
    stored as parquet
    tblproperties('parquet.compression'='SNAPPY', 'external.table.purge'='true')
""")

# ─── STEP 1: Insert new and updated records from RAW source ──────────────────
spark.sql(f"""
    INSERT INTO TABLE {params["com_schema"]}.temp_{{ target_table_name }}_final
    SELECT
        {% for col in original_columns %}
        {{ ", " if not loop.first else "" }}r.{{ col.name }}
        {% endfor %}
        , 'A' AS dl_record_status
        , CASE
            WHEN com_t.{{ primary_key[0] }} IS NOT NULL THEN com_t.dl_record_created_date
            ELSE current_timestamp() END AS dl_record_created_date
        , current_timestamp() AS dl_record_updated_date
    FROM {params["com_schema"]}.temp_{{ target_table_name }}_consolidated r
    LEFT JOIN {params["com_schema"]}.{{ target_table_name }} com_t
        ON {% for k in primary_key %}r.{{ k }} = com_t.{{ k }}{% if not loop.last %} AND {% endif %}{% endfor %}
""")

# ─── STEP 2: Mark records that disappeared from source as deleted ('X') ─────
spark.sql(f"""
    INSERT INTO TABLE {params["com_schema"]}.temp_{{ target_table_name }}_final
    SELECT
        {% for col in original_columns %}
        {{ ", " if not loop.first else "" }}com_t.{{ col.name }}
        {% endfor %}
        , 'X' AS dl_record_status
        , com_t.dl_record_created_date
        , current_timestamp() AS dl_record_updated_date
    FROM {params["com_schema"]}.{{ target_table_name }} com_t
    WHERE NOT EXISTS (
        SELECT 1 FROM {params["com_schema"]}.temp_{{ target_table_name }}_consolidated r
        WHERE {% for k in primary_key %}r.{{ k }} = com_t.{{ k }}{% if not loop.last %} AND {% endif %}{% endfor %}
    )
""")

# ─── STEP 3: Overwrite target table with the final consolidated data ─────────
spark.sql(f"""
    INSERT OVERWRITE TABLE {params["com_schema"]}.{{ target_table_name }}
    SELECT
        {% for col in original_columns %}
        {{ ", " if not loop.first else "" }}{{ col.name }}
        {% endfor %}
        , dl_record_status
        , dl_record_created_date
        , dl_record_updated_date
        , '{batch_date}'       AS etl_dt
        , current_timestamp()  AS etl_timestamp
    FROM {params["com_schema"]}.temp_{{ target_table_name }}_final
""")

spark.sql(f"""
    ANALYZE TABLE {params["com_schema"]}.{{ target_table_name }} COMPUTE STATISTICS
""")

spark.stop()
